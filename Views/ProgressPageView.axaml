<UserControl x:Class="AvaloniaSukiUI.Views.ProgressPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaSukiUI.ViewModels"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:DataType="vm:ProgressPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,40" Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-description" Text="{Binding Description}" />
            </StackPanel>
            <WrapPanel>
                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="进度条">
                        <StackPanel Spacing="15">
                            <ToggleSwitch Content="不确定进度" IsChecked="{Binding IsIndeterminate}" />
                            <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                                         ShowProgressText="True"
                                         Value="{Binding Progress}" />
                            <ProgressBar Classes="Success" Value="84" />
                            <ProgressBar Classes="Warning" Value="42" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding Progress}" />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>
                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="圆形进度">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <suki:CircleProgressBar Width="130" Height="130"
                                                    IsIndeterminate="{Binding IsIndeterminate}"
                                                    StrokeWidth="11"
                                                    Value="{Binding Progress}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding Progress, StringFormat='{}{0:0}%'}" />
                            </suki:CircleProgressBar>
                            <suki:CircleProgressBar Classes="Accent"
                                                    Width="130" Height="130"
                                                    StrokeWidth="11" Value="75" />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>
                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="波浪进度">
                        <suki:WaveProgress Width="190" Height="120"
                                           IsTextVisible="True"
                                           Value="{Binding Progress}" />
                    </suki:GroupBox>
                </suki:GlassCard>
                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="加载动画">
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <suki:Loading LoadingStyle="Simple" />
                            <suki:Loading LoadingStyle="Glow" />
                            <suki:Loading LoadingStyle="Pellets" />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>
            </WrapPanel>
            <suki:GlassCard Padding="20">
                <suki:GroupBox Header="步骤条">
                    <StackPanel Spacing="16">
                        <suki:Stepper Index="{Binding StepIndex}" Steps="{Binding Steps}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Command="{Binding ChangeStepCommand}"
                                    CommandParameter="{x:False}"
                                    Content="上一步" />
                            <Button Grid.Column="2" Classes="Accent"
                                    Command="{Binding ChangeStepCommand}"
                                    CommandParameter="{x:True}"
                                    Content="下一步" />
                        </Grid>
                    </StackPanel>
                </suki:GroupBox>
            </suki:GlassCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
