<UserControl x:Class="AvaloniaSukiUI.Views.CollectionsPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaSukiUI.ViewModels"
             xmlns:content="using:SukiUI.Content"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:DataType="vm:CollectionsPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,40" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-description" Text="{Binding Description}" />
            </StackPanel>

            <suki:GlassCard Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock FontWeight="DemiBold" Text="搜索条件" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,10" Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="用户姓名" />
                            <TextBox Width="180"
                                     PlaceholderText="请输入用户姓名"
                                     Text="{Binding SearchName, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,10" Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="所属团队" />
                            <ComboBox Width="135"
                                      ItemsSource="{Binding TeamFilters}"
                                      SelectedItem="{Binding SelectedTeamFilter, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,10" Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="用户状态" />
                            <ComboBox Width="135"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal" Spacing="8">
                            <Button Classes="Flat"
                                    Command="{Binding SearchCommand}"
                                    Content="搜索">
                                <suki:ButtonExtensions.Icon>
                                    <PathIcon Width="16" Height="16" Data="{x:Static content:Icons.Search}" />
                                </suki:ButtonExtensions.Icon>
                            </Button>
                            <Button Classes="Outlined"
                                    Command="{Binding ResetSearchCommand}"
                                    Content="重置">
                                <suki:ButtonExtensions.Icon>
                                    <PathIcon Width="16" Height="16" Data="{x:Static content:Icons.Refresh}" />
                                </suki:ButtonExtensions.Icon>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </suki:GlassCard>

            <suki:GlassCard Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="DemiBold"
                                   Text="用户列表" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Classes="Flat"
                                    Command="{Binding AddPersonCommand}"
                                    Content="新增">
                                <suki:ButtonExtensions.Icon>
                                    <PathIcon Width="16" Height="16" Data="{x:Static content:Icons.Plus}" />
                                </suki:ButtonExtensions.Icon>
                            </Button>
                            <Button Classes="Outlined"
                                    Command="{Binding EditPersonCommand}"
                                    Content="修改"
                                    IsEnabled="{Binding HasSelection}">
                                <suki:ButtonExtensions.Icon>
                                    <PathIcon Width="16" Height="16" Data="{x:Static content:Icons.Pencil}" />
                                </suki:ButtonExtensions.Icon>
                            </Button>
                            <Button Classes="Danger"
                                    Command="{Binding DeletePersonCommand}"
                                    Content="删除"
                                    IsEnabled="{Binding HasSelection}">
                                <suki:ButtonExtensions.Icon>
                                    <PathIcon Width="16" Height="16" Data="{x:Static content:Icons.Cross}" />
                                </suki:ButtonExtensions.Icon>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Height="330"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              ItemsSource="{Binding People}"
                              SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="135" Binding="{Binding Code}" Header="用户编号" />
                            <DataGridTextColumn Width="120" Binding="{Binding Name}" Header="用户姓名" />
                            <DataGridTextColumn Width="120" Binding="{Binding Team}" Header="所属团队" />
                            <DataGridTextColumn Width="100" Binding="{Binding Status}" Header="状态" />
                            <DataGridTextColumn Width="*" Binding="{Binding Notes}" Header="备注" />
                            <DataGridTemplateColumn Width="100" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <StackPanel HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Classes="Basic Accent Small"
                                                    Command="{Binding DataContext.EditPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="修改">
                                                <PathIcon Width="15" Height="15" Data="{x:Static content:Icons.Pencil}" />
                                            </Button>
                                            <Button Classes="Basic Small"
                                                    Command="{Binding DataContext.DeletePersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="删除">
                                                <PathIcon Width="15" Height="15" Data="{x:Static content:Icons.Cross}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SukiLowText}"
                                       Text="{Binding TotalCount, StringFormat='共 {0} 条'}" />
                            <ComboBox Width="70"
                                      ItemsSource="{Binding PageSizeOptions}"
                                      SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SukiLowText}"
                                       Text="条/页" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Classes="Basic Small"
                                    Command="{Binding PreviousPageCommand}"
                                    IsEnabled="{Binding CanGoPrevious}"
                                    ToolTip.Tip="上一页">
                                <PathIcon Width="14" Height="14" Data="{x:Static content:Icons.ChevronLeft}" />
                            </Button>
                            <ItemsControl ItemsSource="{Binding Pages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PageOption">
                                        <Button Classes="Basic Small"
                                                Classes.Flat="{Binding IsCurrent}"
                                                Command="{Binding SelectCommand}"
                                                Content="{Binding Number}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="Basic Small"
                                    Command="{Binding NextPageCommand}"
                                    IsEnabled="{Binding CanGoNext}"
                                    ToolTip.Tip="下一页">
                                <PathIcon Width="14" Height="14" Data="{x:Static content:Icons.ChevronRight}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </suki:GlassCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
