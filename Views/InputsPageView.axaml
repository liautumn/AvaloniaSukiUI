<UserControl x:Class="AvaloniaSukiUI.Views.InputsPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaSukiUI.ViewModels"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:DataType="vm:InputsPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,40" Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-description" Text="{Binding Description}" />
            </StackPanel>

            <WrapPanel>
                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="文本输入">
                        <StackPanel Spacing="12">
                            <TextBox Classes="field" PlaceholderText="输入项目名称" Text="SukiUI Demo" />
                            <TextBox Classes="field" Height="80" AcceptsReturn="True"
                                     PlaceholderText="多行文本" TextWrapping="Wrap" />
                            <TextBlock Classes="section-label" Text="可选择文本" />
                            <SelectableTextBlock Text="SelectableTextBlock 可复制内容" />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="选择控件">
                        <StackPanel Spacing="12">
                            <ComboBox ItemsSource="{Binding Countries}"
                                      SelectedItem="{Binding SelectedCountry}" />
                            <AutoCompleteBox ItemsSource="{Binding Countries}"
                                             PlaceholderText="搜索国家" />
                            <ListBox MaxHeight="125" ItemsSource="{Binding Roles}" SelectedIndex="1" />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="开关与复选">
                        <StackPanel Spacing="13">
                            <CheckBox Content="接收产品更新" IsChecked="{Binding NotificationsEnabled}" />
                            <CheckBox Content="启用高级功能" IsChecked="{Binding AdvancedEnabled}" />
                            <RadioButton Content="个人账户" GroupName="account" IsChecked="True" />
                            <RadioButton Content="团队账户" GroupName="account" />
                            <ToggleSwitch IsChecked="{Binding NotificationsEnabled}"
                                          OffContent="已关闭" OnContent="已开启" />
                            <ToggleButton Classes="Switch Accent" Content="Switch 风格" IsChecked="True" />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>

                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="数值与滑块">
                        <StackPanel Spacing="14">
                            <NumericUpDown Minimum="0" Maximum="100" Value="42" />
                            <NumericUpDown Minimum="0" Maximum="10" Increment="0.5" Value="3.5" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" />
                            <TextBlock Text="{Binding Volume, StringFormat='音量 {0:0}%'}" />
                            <ProgressBar ShowProgressText="True" Value="{Binding Volume}" />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>
                <suki:GlassCard Classes="demo-card">
                    <suki:GroupBox Header="日期与时间">
                        <StackPanel Spacing="12">
                            <DatePicker />
                            <CalendarDatePicker />
                            <TimePicker />
                        </StackPanel>
                    </suki:GroupBox>
                </suki:GlassCard>
            </WrapPanel>

            <suki:GlassCard Padding="20">
                <suki:GroupBox Header="Form 表单">
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                        <TextBlock VerticalAlignment="Center" Text="姓名" />
                        <TextBox Grid.Column="1" PlaceholderText="请输入姓名" Text="{Binding UserName}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="邮箱" />
                        <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="name@example.com" Text="{Binding Email}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="国家/地区" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding Countries}"
                                  SelectedItem="{Binding SelectedCountry}" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="选项" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="接收通知" IsChecked="{Binding NotificationsEnabled}" />
                            <ToggleSwitch Content="高级功能" IsChecked="{Binding AdvancedEnabled}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Button Classes="Accent" Command="{Binding SubmitFormCommand}" Content="提交" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SukiLowText}"
                                       Text="{Binding FormStatus}" />
                        </StackPanel>
                    </Grid>
                </suki:GroupBox>
            </suki:GlassCard>

            <suki:GlassCard Padding="20">
                <suki:GroupBox Header="颜色与菜单">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ColorPicker Width="240" />
                        <Button Classes="Flat" Content="右键打开菜单">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="剪切" />
                                    <MenuItem Header="复制" />
                                    <MenuItem Header="粘贴" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Classes="Outlined" Content="打开 Flyout">
                            <Button.Flyout>
                                <Flyout>
                                    <Border Padding="18"><TextBlock Text="这是一个 Flyout 内容面板。" /></Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </suki:GroupBox>
            </suki:GlassCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
