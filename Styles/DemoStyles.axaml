<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="https://github.com/kikipoulet/SukiUI">
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="DemiBold" />
    </Style>
    <Style Selector="TextBlock.page-description">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="DemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>
    <Style Selector="suki|GlassCard.demo-card">
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinWidth" Value="280" />
    </Style>
    <Style Selector="suki|GroupBox">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Button.action">
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="TextBox.field">
        <Setter Property="MinWidth" Value="220" />
    </Style>
</Styles>
